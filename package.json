    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "drizzle-kit": "0.31.10",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "microsandbox": "^0.5.10",
    "typescript": "7.0.2"
  }
