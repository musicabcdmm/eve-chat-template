{
  "name": "eve-chat-template",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:production": "vercel env run -e production -- pnpm db:migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev",
    "start": "next start",
    "typecheck": "next typegen && tsgo --noEmit -p tsconfig.json",
    "build:eve": "eve build",
    "dev:eve": "eve dev",
    "start:eve": "eve start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@node-rs/bcrypt": "^1.10.0",
    "@shikijs/core": "4.3.1",
    "@shikijs/engine-javascript": "4.3.1",
    "@shikijs/engine-oniguruma": "4.3.1",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@tailwindcss/postcss": "4.3.3",
    "@upstash/redis": "1.38.2",
    "@vercel/analytics": "2.0.1",
    "@vercel/connect": "0.8.0",
    "@vercel/speed-insights": "2.0.0",
    "ai": "7.0.70",
    "better-auth": "1.7.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.2",
    "eve": "^0.39.3",
    "fluent-ffmpeg": "^2.1.2",
    "lucide-react": "1.33.0",
    "next": "16.3.1",
    "next-auth": "^5.0.0",
    "nodemailer": "^6.9.7",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.32.6",
    "shiki": "4.3.1",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
