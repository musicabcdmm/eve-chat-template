# Environment Variables - eve Chat Template

## Database
DATABASE_URL=postgresql://user:password@host:5432/database

## Authentication
BETTER_AUTH_SECRET=your-secret-key
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=your-vercel-oauth-client-id
VERCEL_APP_CLIENT_SECRET=your-vercel-oauth-secret

## Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@eve-chat.com

## Storage
VERCEL_BLOB_READ_WRITE_TOKEN=your-vercel-blob-token

## Next Auth
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret

## Optional
SLACK_CONNECTOR=
LINEAR_CONNECTOR=
NOTION_CONNECTOR=
SENTRY_CONNECTOR=
